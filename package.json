{
  "name": "vegitable-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,store,admin\" -c \"yellow,green,cyan\" \"npm run dev:backend\" \"npm run dev:store\" \"npm run dev:admin\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:store": "npm --prefix frontend/store run dev",
    "dev:admin": "npm --prefix frontend/admin run dev",
    "build": "npm --prefix backend run build",
    "postinstall": "npm --prefix backend run prisma:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
