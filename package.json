{
  "name": "vegitable-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,store,admin\" -c \"yellow,green,cyan\" \"npm run dev:backend\" \"npm run dev:store\" \"npm run dev:admin\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:store": "npm --prefix frontend/store run dev",
    "dev:admin": "npm --prefix frontend/admin run dev",
    "build": "npm run build:backend ; npm run build:store ; npm run build:admin",
    "build:backend": "npm --prefix backend run build",
    "build:store": "npm --prefix frontend/store run build",
    "build:admin": "npm --prefix frontend/admin run build",
    "db:push": "npm --prefix backend run prisma:push",
    "db:seed": "npm --prefix backend run seed"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
