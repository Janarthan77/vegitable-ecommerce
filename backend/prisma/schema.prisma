datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Category {
  id        String    @id @default(uuid())
  name      String
  tamilName String
  slug      String    @unique
  emoji     String
  color     String    @default("emerald")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  tamilName   String
  price       Float
  unit        String   @default("kg") // kg, g, piece, bunch
  imageUrl    String?  // Cloudflare R2 / Cloudflare CDN Public URL stored here!
  emoji       String   @default("🥬")
  description String?
  inStock     Boolean  @default(true)
  discount    Int?     @default(0) // Discount percentage
  isPopular   Boolean  @default(false)
  
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String   @id @default(uuid())
  customerName    String
  customerPhone   String
  customerAddress String
  notes           String?
  status          String   @default("pending") // pending, confirmed, preparing, out-for-delivery, delivered, cancelled
  total           Float
  items           String   // JSON stringified CartItem array [{ product, quantity, weight }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StoreSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
